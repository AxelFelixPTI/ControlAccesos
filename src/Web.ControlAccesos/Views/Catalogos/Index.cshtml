@{ ViewData["Titulo"] = "Catálogos"; ViewData["Migas"] = "Administración · Sede VES"; }
<div class="stack" id="caf-catalogos" data-url-listar="@Url.Action("Listar", "Catalogos")" data-url-guardar="@Url.Action("Guardar", "Catalogos")"
     data-url-ck-listar="@Url.Action("Listar", "ChecklistPorteria")" data-url-ck-guardar="@Url.Action("Guardar", "ChecklistPorteria")"
     data-url-tp-listar="@Url.Action("Listar", "TiposIngreso")" data-url-tp-guardar="@Url.Action("Guardar", "TiposIngreso")"
     data-url-sub-listar="@Url.Action("Subtipos", "TiposIngreso")" data-url-sub-guardar="@Url.Action("SubtipoGuardar", "TiposIngreso")"
     data-url-sub-estado="@Url.Action("SubtipoEstado", "TiposIngreso")" data-url-sub-pred="@Url.Action("SubtipoPredeterminado", "TiposIngreso")">
    @Html.AntiForgeryToken()

    <section class="card">
        <div class="card-hd">
            <div>
                <h3>Zonas de VES</h3>
                <p class="small muted">Lo que marque aquí decide los avisos de la solicitud y los ítems del checklist en portería.</p>
            </div>
            <button type="button" class="btn" data-nuevo="zona">+ Nueva zona</button>
        </div>
        <div class="tw">
            <table class="tabla">
                <thead><tr><th class="stk">Zona</th><th>Tipo</th><th>Exige SCTR</th><th>Exige EPP</th><th>Estado</th><th></th></tr></thead>
                <tbody id="cat-zona"><tr><td colspan="6" class="vacio">Cargando...</td></tr></tbody>
            </table>
        </div>
    </section>

    <section class="card" id="caf-tipos">
        <div class="card-hd">
            <div>
                <h3>Tipos de ingreso</h3>
                <p class="small muted">Los tipos que se ofrecen al crear una solicitud. Un tipo nuevo usa el flujo estándar de visitante; luego se le ajusta el checklist más abajo.</p>
            </div>
            <button type="button" class="btn" id="tp-nuevo">+ Nuevo tipo</button>
        </div>
        <div class="tw">
            <table class="tabla">
                <thead><tr><th class="stk">Tipo</th><th>Aprobación</th><th>Disponible</th><th>Orden</th><th>Subtipos de persona</th><th>Configurado</th><th>Estado</th><th></th></tr></thead>
                <tbody id="tp-filas"><tr><td colspan="8" class="vacio">Cargando...</td></tr></tbody>
            </table>
        </div>
    </section>

    <section class="card" id="caf-checklist">
        <div class="card-hd">
            <div>
                <h3>Checklist de portería</h3>
                <p class="small muted">Lo que el vigilante verifica al registrar un ingreso o una salida. Elija a qué tipos de ingreso se ofrece cada ítem y cuándo aplica.</p>
            </div>
            <button type="button" class="btn" id="ck-nuevo">+ Nuevo ítem</button>
        </div>
        <div class="tw">
            <table class="tabla">
                <thead><tr><th class="stk">Ítem</th><th>Etapa</th><th>Aplica</th><th>Crítico</th><th>Orden</th><th>Se ofrece a</th><th>Estado</th><th></th></tr></thead>
                <tbody id="ck-filas"><tr><td colspan="8" class="vacio">Cargando...</td></tr></tbody>
            </table>
        </div>
    </section>

    <div class="grid g2 cat3">
        <section class="card">
            <h3>Áreas</h3>
            <p class="small muted">Se elige al registrar al personal y a los usuarios (Personal y Usuarios y roles).</p>
            <ul class="clist" id="cat-area"></ul>
            <button type="button" class="btn" data-nuevo="area">+ Agregar</button>
        </section>
        <section class="card">
            <h3>Cargos</h3>
            <p class="small muted">Se elige al registrar al personal y a los usuarios. Es opcional en la ficha.</p>
            <ul class="clist" id="cat-cargo"></ul>
            <button type="button" class="btn" data-nuevo="cargo">+ Agregar</button>
        </section>
    </div>

    <div class="grid g3 cat3">
        <section class="card">
            <h3>Motivos de visita</h3>
            <p class="small muted">Lista del paso 1 de la solicitud. «Otro» siempre existe.</p>
            <ul class="clist" id="cat-motivo"></ul>
            <button type="button" class="btn" data-nuevo="motivo">+ Agregar</button>
        </section>
        <section class="card">
            <h3>Tratamientos de desviación</h3>
            <p class="small muted">Decisiones que Vigilancia registra según lo indicado por el Coordinador. «Otro» siempre existe.</p>
            <ul class="clist" id="cat-tratamiento"></ul>
            <button type="button" class="btn" data-nuevo="tratamiento">+ Agregar</button>
        </section>
        <section class="card">
            <h3>Tipos de incidencia</h3>
            <p class="small muted">Faltas que puede cometer una persona que ingresó. «Otro» siempre existe.</p>
            <ul class="clist" id="cat-incidencia"></ul>
            <button type="button" class="btn" data-nuevo="incidencia">+ Agregar</button>
        </section>
    </div>
</div>
<div class="toasts" id="toasts" aria-live="polite"></div>
<script src="~/js/caf.js" asp-append-version="true"></script>
<script src="~/js/catalogos/catalogos.js" asp-append-version="true"></script>
<script src="~/js/catalogos/tipos.js" asp-append-version="true"></script>
<script src="~/js/catalogos/checklist.js" asp-append-version="true"></script>
