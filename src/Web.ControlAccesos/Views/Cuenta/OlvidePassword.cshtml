@model OlvidePasswordVM
@{ ViewData["Titulo"] = "Recuperar contraseña"; }
<section class="card login-card">
    <div class="brand dark"><span class="logo"><i></i></span><span><b>TRIANON</b><small>Control de Accesos &middot; VES</small></span></div>
    <h2>Recuperar contraseña</h2>
    <p class="small muted">Escriba el correo con el que ingresa. Le enviaremos un enlace para definir una contraseña nueva.</p>
    <form asp-action="OlvidePassword" method="post" autocomplete="off" class="stack">
        <div asp-validation-summary="ModelOnly" class="aviso a-danger" role="alert"></div>
        <div class="field">
            <label asp-for="Correo" class="field-l"></label>
            <input asp-for="Correo" type="email" autofocus autocomplete="username" />
            <span asp-validation-for="Correo" class="campo-error"></span>
        </div>
        <button type="submit" class="btn btn-primary">Enviarme el enlace</button>
        <a class="small" asp-action="Ingresar">Volver a ingresar</a>
    </form>
</section>
