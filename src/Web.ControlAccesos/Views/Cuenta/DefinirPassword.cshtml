@model DefinirPasswordVM
@{ ViewData["Titulo"] = "Definir contraseña"; }
<section class="card login-card">
    <div class="brand dark"><span class="logo"><i></i></span><span><b>TRIANON</b><small>Control de Accesos &middot; VES</small></span></div>
    <h2>Defina su contraseña</h2>
    <form asp-action="DefinirPassword" method="post" autocomplete="off" class="stack">
        <input type="hidden" asp-for="Token" />
        <div asp-validation-summary="ModelOnly" class="aviso a-danger" role="alert"></div>
        <div class="field">
            <label asp-for="Nueva" class="field-l"></label>
            <input asp-for="Nueva" autofocus autocomplete="new-password" />
            <span class="field-h">Mínimo 10 caracteres.</span>
            <span asp-validation-for="Nueva" class="campo-error"></span>
        </div>
        <div class="field">
            <label asp-for="Confirmar" class="field-l"></label>
            <input asp-for="Confirmar" autocomplete="new-password" />
            <span asp-validation-for="Confirmar" class="campo-error"></span>
        </div>
        <button type="submit" class="btn btn-primary">Guardar contraseña</button>
        <p class="small muted">Este enlace sirve una sola vez y vence en unos días. Si ya no funciona, pida otro desde «¿Olvidó su contraseña?» en la pantalla de ingreso.</p>
    </form>
</section>
