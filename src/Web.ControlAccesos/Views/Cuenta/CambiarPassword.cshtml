@model CambiarPasswordVM
@{ ViewData["Titulo"] = "Cambiar contraseña"; ViewData["Migas"] = "Mi cuenta"; }
<section class="card">
    @if (User.RequiereCambioPassword())
    {
        <div class="aviso a-warn" role="alert">Debe cambiar su contraseña para continuar.</div>
    }
    <form asp-action="CambiarPassword" method="post" autocomplete="off" class="stack">
        <div asp-validation-summary="ModelOnly" class="aviso a-danger" role="alert"></div>
        <div class="field">
            <label asp-for="Actual" class="field-l"></label>
            <input asp-for="Actual" autocomplete="current-password" />
            <span asp-validation-for="Actual" class="campo-error"></span>
        </div>
        <div class="field">
            <label asp-for="Nueva" class="field-l"></label>
            <input asp-for="Nueva" autocomplete="new-password" />
            <span class="field-h">Mínimo 10 caracteres.</span>
            <span asp-validation-for="Nueva" class="campo-error"></span>
        </div>
        <div class="field">
            <label asp-for="Confirmar" class="field-l"></label>
            <input asp-for="Confirmar" autocomplete="new-password" />
            <span asp-validation-for="Confirmar" class="campo-error"></span>
        </div>
        <div class="row-end"><button type="submit" class="btn btn-primary">Guardar</button></div>
    </form>
</section>
