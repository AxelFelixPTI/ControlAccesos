@inject MenuCaf Menu
@{
    var autenticado = User.Identity?.IsAuthenticated == true;
    var conMenu = autenticado && !User.RequiereCambioPassword();
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    var accionActual = ViewContext.RouteData.Values["action"]?.ToString();
    var migas = ViewData["Migas"] as string ?? "";
    var titulo = ViewData["Titulo"] as string ?? "Control de Accesos";
    var nombre = User.Identity?.Name ?? "";
    var roles = autenticado ? Menu.Roles(User) : new List<string>();
    var rolActivo = autenticado ? Menu.RolActivo(User, Context.Request.Cookies[MenuCaf.CookieRol]) : null;
    var iniciales = string.Concat(nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0])));
}
<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@titulo · Control de Accesos · Grupo Trianon</title>
    <script src="~/js/tema.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (autenticado)
{
    <div class="app @(conMenu ? "" : "sin-lateral")">
        @if (conMenu)
        {
            <aside class="side" id="lateral">
                <div class="brand"><span class="logo"><i></i></span><span><b>TRIANON</b><small>Control de Accesos · VES</small></span><button type="button" class="menu-t" id="menu-t" aria-label="Menú">&#9776;</button></div>
                <nav aria-label="Menú principal">
                    <a class="nav-i @(controlador == "Inicio" ? "on" : "")" asp-controller="Inicio" asp-action="Index"><span>Inicio</span></a>
                    @foreach (var grupo in Menu.Para(User, rolActivo))
                    {
                        <p class="nav-r">@grupo.Key</p>
                        @foreach (var e in grupo)
                        {
                            if (e.Disponible)
                            {
                                <a class="nav-i @(controlador == e.Controlador && ((e.Controlador != "Solicitudes" && e.Controlador != "Incidencias") || e.Accion == accionActual || (e.Accion == "Index" && accionActual == "Detalle")) ? "on" : "")" asp-controller="@e.Controlador" asp-action="@e.Accion"><span>@e.Titulo</span></a>
                            }
                            else
                            {
                                <span class="nav-i pronto" title="Pantalla en construcción"><span>@e.Titulo</span><em>pronto</em></span>
                            }
                        }
                    }
                </nav>
                <p class="side-f">Etapa 1 · Visita externa</p>
            </aside>
        }
        <main class="main">
            <header class="top">
                <div><p class="crumb">@migas</p><h1>@titulo</h1></div>
                <div class="who">
                    <div class="who-t"><b>@nombre</b><small>@User.Correo()</small>
                        @if (roles.Count > 1)
                        {
                            <form asp-controller="Cuenta" asp-action="CambiarRol" method="post" class="en-linea" id="rol-f">
                                <select name="rol" id="rol-sel" aria-label="Rol activo">
                                    <option value="" selected="@(rolActivo is null)">Todos mis roles</option>
                                    @foreach (var r in roles)
                                    {
                                        <option value="@r" selected="@(r == rolActivo)">@r</option>
                                    }
                                </select>
                                <noscript><button type="submit" class="btn btn-sm">Cambiar</button></noscript>
                            </form>
                        }
                    </div>
                    <span class="avatar">@iniciales</span>
                    <button type="button" class="btn btn-sm btn-tema" id="btn-tema" title="Cambiar tema claro/oscuro" aria-label="Cambiar tema claro u oscuro">
                        <svg class="i-luna" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
                        <svg class="i-sol" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                    </button>
                    <form asp-controller="Cuenta" asp-action="Salir" method="post" class="en-linea">
                        <button type="submit" class="btn btn-sm">Salir</button>
                    </form>
                </div>
            </header>
            <div class="content">
                @if (TempData["Aviso"] is string aviso)
                {
                    <div class="aviso a-ok" role="status">@aviso</div>
                }
                @RenderBody()
            </div>
        </main>
    </div>
}
else
{
    <main class="login">@RenderBody()</main>
}
<script src="~/js/layout.js" asp-append-version="true"></script>
</body>
</html>
