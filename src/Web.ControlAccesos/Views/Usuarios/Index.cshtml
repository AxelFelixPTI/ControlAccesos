@{ ViewData["Titulo"] = "Usuarios y roles"; ViewData["Migas"] = "Administración"; }
<div class="split" id="caf-usuarios" data-url-listar="@Url.Action("Listar", "Usuarios")" data-url-opciones="@Url.Action("Opciones", "Usuarios")" data-url-guardar="@Url.Action("Guardar", "Usuarios")" data-url-enlace="@Url.Action("Enlace", "Usuarios")">
    @Html.AntiForgeryToken()
    <section class="card">
        <div class="filtros f2">
            <label class="field"><span class="field-l">Buscar</span><input type="text" id="u-buscar" placeholder="Nombre, documento o correo" autocomplete="off" /></label>
            <label class="field"><span class="field-l">Rol</span><select id="u-rol"><option value="">Todos</option></select></label>
        </div>
        <div class="tw">
            <table class="tabla">
                <thead><tr><th class="stk">Usuario</th><th>Área o empresa</th><th>Roles en VES</th><th>Estado</th><th></th></tr></thead>
                <tbody id="u-filas"><tr><td colspan="5" class="vacio">Cargando...</td></tr></tbody>
            </table>
        </div>
    </section>
    <section class="card side-form" id="u-lateral"></section>
</div>
<div class="toasts" id="toasts" aria-live="polite"></div>
<script src="~/js/caf.js" asp-append-version="true"></script>
<script src="~/js/usuarios/usuarios.js" asp-append-version="true"></script>
